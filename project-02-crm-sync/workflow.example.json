        "jsCode": "const fin = $('Build Sync Plan').all().map((i) => i.json).find((r) => r._finish);\nreturn [{ json: {\n  run_at: $('Init Run').first().json.run_started_at, object: 'sync', record_id: '', action: fin.mode, status: 'ok',\n  message: `contacts: ${fin.contacts}, deals: ${fin.deals}, pending alerts: ${fin.pending.length}`,\n} }];"
