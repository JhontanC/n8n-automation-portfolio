      "id": "p2000000-0014-4000-8000-000000000014",
      "name": "Read Deals Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2220,
        0
      ],
      "executeOnce": true,
      "alwaysOutputData": true
