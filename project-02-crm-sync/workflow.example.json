    {
      "parameters": {
        "jsCode": "// Compares HubSpot changes with the sheet and decides what to write and what to notify.\nconst init = $('Init Run').first().json;\nconst now = init.run_started_at;\nconst v = (x) => (x === null || x === undefined ? '' : String(x));\n\nconst uniqueById = (list) => [...new Map(list.map((r) => [String(r.id), r])).values()];\nconst hsContacts = uniqueById($('HubSpot - Search Contacts').all().flatMap((i) => i.json.results || []));\nconst hsDeals = uniqueById($('HubSpot - Search Deals').all().flatMap((i) => i.json.results || []));\n\nconst stageLabels = {};\nfor (const p of $('HubSpot - Deal Pipelines').first().json.results || []) {\n  for (const s of p.stages || []) stageLabels[s.id] = s.label;\n}\n\nconst dealContact = {};\nif ($('HubSpot - Deal Contacts').isExecuted) {\n  for (const i of $('HubSpot - Deal Contacts').all()) {\n    for (const r of i.json.results || []) {\n      const first = (r.to || [])[0];\n      if (first) dealContact[String(r.from.id)] = String(first.toObjectId);\n    }\n  }\n}\n\nconst sheetRows = (node, key) => Object.fromEntries(\n  $(node).all().map((i) => i.json).filter((r) => v(r[key]) !== '').map((r) => [v(r[key]), r]),\n);\nconst sheetContacts = sheetRows('Read Contacts Sheet', 'hubspot_contact_id');\nconst sheetDeals = sheetRows('Read Deals Sheet', 'hubspot_deal_id');\n\n// Rows to upsert (only records that changed in HubSpot)\nconst contactRows = hsContacts.map((c) => {\n  const p = c.properties || {};\n  const row = {\n    hubspot_contact_id: v(c.id), email: v(p.email), first_name: v(p.firstname), last_name: v(p.lastname),\n    phone: v(p.phone), city: v(p.city), lead_source: v(p.lead_source), service_type: v(p.service_type),\n    lifecycle_stage: v(p.lifecyclestage), created_at: v(p.createdate), updated_at: v(p.lastmodifieddate),\n    synced_at: now, sync_status: 'ok',\n  };\n  // New rows start as \"pending alert\" (empty) - except on the first full copy.\n  if (!sheetContacts[row.hubspot_contact_id]) row.new_lead_notified = init.backfill ? 'backfill' : '';\n  return row;\n});\n\nconst dealRows = hsDeals.map((d) => {\n  const p = d.properties || {};\n  const dealId = v(d.id);\n  const existing = sheetDeals[dealId];\n  const row = {\n    hubspot_deal_id: dealId,\n    hubspot_contact_id: dealContact[dealId] || v(existing && existing.hubspot_contact_id),\n    deal_name: v(p.dealname), stage_id: v(p.dealstage), stage_label: stageLabels[p.dealstage] || v(p.dealstage),\n    amount: v(p.amount), created_at: v(p.createdate), updated_at: v(p.hs_lastmodifieddate),\n    is_closed: p.hs_is_closed === 'true', is_won: p.hs_is_closed_won === 'true',\n    // HubSpot fills closedate when a deal is closed; on open deals it is only an expected date, so it is ignored.\n    closed_at: p.hs_is_closed === 'true' ? v(p.closedate) : '',\n    synced_at: now, sync_status: 'ok',\n  };\n  // A new deal is not an alert by itself (the new lead alert covers it); only later stage changes are.\n  if (!existing) row.notified_stage = row.stage_id;\n  return row;\n});\n\n// Pending alerts come from the merged state, so alerts that failed in earlier runs are retried.\nconst merged = (sheet, rows, key) => {\n  const out = { ...sheet };\n  for (const r of rows) out[r[key]] = { ...(sheet[r[key]] || {}), ...r };\n  return Object.values(out);\n};\nconst SERVICE = { installation: 'Installation', maintenance: 'Maintenance', repair: 'Repair', inspection: 'Inspection', quote: 'Quote' };\nconst SOURCE = { website: 'Website', referral: 'Referral', google_ads: 'Google Ads', social_media: 'Social media', other: 'Other' };\n\nconst pending = [];\nfor (const c of merged(sheetContacts, contactRows, 'hubspot_contact_id')) {\n  if (v(c.new_lead_notified) !== '') continue;\n  const name = [c.first_name, c.last_name].filter(Boolean).join(' ') || 'Unnamed lead';\n  pending.push({\n    kind: 'contact', hubspot_contact_id: v(c.hubspot_contact_id),\n    message: `:new: *New lead:* ${name}\\nService: ${SERVICE[c.service_type] || c.service_type || 'n/a'} · City: ${c.city || 'n/a'} · Source: ${SOURCE[c.lead_source] || c.lead_source || 'n/a'}`,\n  });\n}\nfor (const d of merged(sheetDeals, dealRows, 'hubspot_deal_id')) {\n  const from = v(d.notified_stage);\n  const to = v(d.stage_id);\n  if (!from || !to || from === to) continue;\n  const won = d.is_won === true || v(d.is_won).toUpperCase() === 'TRUE';\n  pending.push({\n    kind: 'deal', hubspot_deal_id: v(d.hubspot_deal_id), stage_id: to,\n    message: `${won ? ':tada:' : ':arrows_counterclockwise:'} *Deal stage changed:* ${d.deal_name}\\n${stageLabels[from] || from} → *${stageLabels[to] || to}*`,\n  });\n}\n\nreturn [\n  ...contactRows.map((json) => ({ json })),\n  ...dealRows.map((json) => ({ json })),\n  { json: { _finish: true, mode: init.backfill ? 'backfill' : 'incremental', contacts: contactRows.length, deals: dealRows.length, pending } },\n];"
      },
      "id": "p2000000-0015-4000-8000-000000000015",
      "name": "Build Sync Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2440,
        0
