    {
      "parameters": {
        "jsCode": "// Turns the API error into a short, readable log line (no HTML bodies).\nconst e = $input.first().json.error || {};\nconst raw = String(e.message || e.description || e || 'unknown error');\nconst title = raw.match(/<title>([^<]*)<\\/title>/i);\nconst short = (title ? title[1] : raw.replace(/<[^>]*>/g, ' ')).replace(/\\s+/g, ' ').replace(/^\\d{3}\\s*-\\s*\"?/, '').trim();\nconst code = (raw.match(/^(\\d{3})/) || [])[1] || e.httpCode || '';\nreturn [{ json: {\n  run_at: new Date().toISOString(), object: 'hubspot', record_id: '', action: 'read', status: 'error',\n  message: ('HubSpot ' + (code ? code + ': ' : '') + short).slice(0, 160) + ' | cursor not moved, next run retries',\n} }];"
      },
