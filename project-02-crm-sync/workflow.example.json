      "parameters": {
        "jsCode": "// Decide which time window to read from HubSpot.\nconst row = $input.all().map((i) => i.json).find((r) => r.key === 'last_synced_at') || {};\nconst last = row.value ? String(row.value) : '';\nconst lastMs = last ? Date.parse(last) : NaN;\nconst OVERLAP_MS = 5 * 60 * 1000; // re-read 5 min to cover HubSpot search indexing delay\n\nreturn [{\n  json: {\n    run_started_at: new Date().toISOString(),\n    last_synced_at: last || null,\n    since_ms: Number.isNaN(lastMs) ? null : lastMs - OVERLAP_MS,\n    backfill: Number.isNaN(lastMs), // first run: copy everything, send no alerts\n  },\n}];"
      },
