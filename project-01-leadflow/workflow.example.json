    {
      "parameters": {
        "jsCode": "// Validate and normalize the incoming quote request.\nconst SERVICE_TYPES = { installation: 'AC Installation', maintenance: 'AC Maintenance', repair: 'AC Repair', inspection: 'AC Inspection', quote: 'AC Quote' };\nconst EMAIL_RE = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/;\n\nconst clean = (v) => (typeof v === 'string' ? v.trim().replace(/\\s+/g, ' ') : '');\n\n// 'maria da silva' -> 'Maria da Silva', 'são paulo' -> 'São Paulo'\nconst LOWER_WORDS = new Set(['da', 'de', 'do', 'das', 'dos', 'e']);\nconst titleCase = (s) => s.toLowerCase().split(' ')\n  .map((w, i) => (i > 0 && LOWER_WORDS.has(w) ? w : w.charAt(0).toUpperCase() + w.slice(1)))\n  .join(' ');\n\nreturn $input.all().map((item) => {\n  const body = item.json.body || {};\n  const errors = [];\n\n  const name = titleCase(clean(body.name));\n  const email = clean(body.email).replace(/\\s/g, '').toLowerCase();\n  const phone = clean(body.phone).replace(/[^\\d+]/g, '');\n  const service_type = clean(body.service_type).toLowerCase();\n  const city = titleCase(clean(body.city));\n  const message = clean(body.message).slice(0, 1000);\n  const source = clean(body.source) || 'website';\n\n  if (name.length < 2) errors.push({ field: 'name', error: 'required' });\n  if (!email) errors.push({ field: 'email', error: 'required' });\n  else if (!EMAIL_RE.test(email)) errors.push({ field: 'email', error: 'invalid_format' });\n  if (!SERVICE_TYPES[service_type]) errors.push({ field: 'service_type', error: 'must_be_one_of', allowed: Object.keys(SERVICE_TYPES) });\n  if (!city) errors.push({ field: 'city', error: 'required' });\n\n  // HubSpot contact properties. Empty values are left out so an update never erases existing data.\n  const [firstname, ...rest] = name.split(' ');\n  const contact_properties = { email, firstname, lastname: rest.join(' '), phone, city };\n  for (const key of Object.keys(contact_properties)) {\n    if (!contact_properties[key]) delete contact_properties[key];\n  }\n\n  return {\n    json: {\n      valid: errors.length === 0,\n      errors,\n      lead: {\n        name, email, phone, service_type, city, message, source,\n        deal_name: `${SERVICE_TYPES[service_type] || 'AC Request'} - ${name} (${city})`,\n        submitted_at: new Date().toISOString(),\n      },\n      contact_properties,\n    },\n  };\n});"
      },
