    {
      "parameters": {
        "jsCode": "// Input is either the deals batch read (deals have .properties) or the empty association list.\nconst contact = $('Contact Result').first().json;\nconst deals = ($input.first().json.results || []).filter((d) => d.properties);\nconst openDeal = deals.find((d) => d.properties.hs_is_closed !== 'true');\n\nreturn [{ json: { ...contact, open_deal_id: openDeal ? openDeal.id : null } }];"
      },
